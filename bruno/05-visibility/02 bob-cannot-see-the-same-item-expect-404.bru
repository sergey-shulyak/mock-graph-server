meta {
  name: bob cannot see the same item (expect 404)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1.0/drives/{{driveId}}/root:/Engineering/Backend/prod-access.md:
  body: none
  auth: none
}

headers {
