meta {
  name: direct group memberships of alice (expect 200)
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/v1.0/users/alice/memberOf
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

docs {
  memberOf returns directoryObjects with @odata.type #microsoft.graph.group
}

assert {
  res.status: eq 200
}
